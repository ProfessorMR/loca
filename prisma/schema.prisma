
generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Place {
  id          String   @id @default(cuid())
  osmId       String?  @unique
  source      String   @default("openstreetmap")

  name        String
  category    String
  tags        String[] @default([])
  address     String?
  latitude    Float?
  longitude   Float?

  description String?
  image       String?
  imageSource String?
  imageAttribution String?
  imageLicense String?

  rating      Float?
  ratingCount Int?
  ratingSource String?
  priceLevel  String?
  distance    String?

  website          String?
  phone            String?
  openingHours     String?
  wikimediaCommons String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([rating])
  @@index([source])
}
